{
    "name": "@jsbot-tellus/core",
    "version": "2.5.0",
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    },
    "description": "a new version of JsBot",
    "keywords": [
        "Cordis",
        "Bot",
        "Typescript"
    ],
    "homepage": "https://github.com/JsBot-Dev/JsBot-Tellus#readme",
    "bugs": {
        "url": "https://github.com/JsBot-Dev/JsBot-Tellus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JsBot-Dev/JsBot-Tellus.git"
    },
    "license": "AGPL-3.0-or-later",
    "author": "J-SLY",
    "type": "module",
    "files": [
        "dist",
        "src",
        "docs",
        "examples",
        "bot.config.example.json"
    ],
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "jsbot": "dist/app.js"
    },
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "dev:webui": "vite --config webui/vite.config.ts",
        "start": "node dist/app.js",
        "start:build": "npm run build && npm start",
        "start:source": "tsx src/app.ts",
        "smoke": "node dist/app.js --help",
        "build": "npm run clean && npm run build:webui && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/app.js', 0o755)\"",
        "build:webui": "vite build --config webui/vite.config.ts",
        "build:plugin": "node scripts/plugins.mjs build",
        "check": "tsc --noEmit",
        "check:webui": "node scripts/webui-check.cjs",
        "check:plugin": "node scripts/plugins.mjs check",
        "check:all": "npm run check && npm run check:webui && npm run check:plugin",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:plugin": "prettier --write \"plugins/*/src/**/*.{ts,js,vue,css,json,md}\" \"plugins/*/*.{json,md}\" --ignore-path ''",
        "format:plugin:check": "prettier --check \"plugins/*/src/**/*.{ts,js,vue,css,json,md}\" \"plugins/*/*.{json,md}\" --ignore-path ''",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "plugin:gen": "tsx scripts/plugin-gen.ts",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run check:webui && npm test"
    },
    "dependencies": {
        "@snowluma/sdk": "^2.2.0",
        "fast-glob": "^3.3.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@types/node": "^24.6.4",
        "@vitejs/plugin-vue": "^6.0.10",
        "element-plus": "^2.14.7",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "typescript5": "npm:typescript@5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.4",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.13"
    }
}
